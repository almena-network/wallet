<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS: merged by Tauri into the bundle's Info.plist. Why the camera and
	     the microphone are asked for, which macOS shows when a call first
	     needs them; without these the system refuses them outright. -->
	<key>NSCameraUsageDescription</key>
	<string>Almena Wallet uses the camera for video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Almena Wallet uses the microphone for calls.</string>
</dict>
</plist>
